+static void
+tilegroup(Client *c, unsigned int n, int x, int y, int w, int h, int gap)
+{
+	unsigned int i;
+	int outerh, remaining = MAX(1, h);
+
+	for (i = 0; i < n && c; i++, c = nexttiled(c->next)) {
+		int slots = n - i;
+
+		outerh = (remaining - gap * (slots - 1)) / slots;
+		outerh = MAX(1, outerh);
+		if (i == n - 1)
+			outerh = MAX(1, remaining);
+		resize(c, x, y, MAX(1, w - 2 * c->bw),
+			MAX(1, outerh - 2 * c->bw), 0);
+		y += HEIGHT(c) + gap;
+		remaining -= HEIGHT(c);
+		if (i + 1 < n)
+			remaining -= gap;
+	}
+}
