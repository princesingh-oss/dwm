+void
+setgaps(const Arg *arg)
+{
+	long long gap;
+
+	if (!arg || arg->i == 0) {
+		selmon->gappx = 0;
+	} else {
+		gap = (long long)selmon->gappx + arg->i;
+		if (gap < 0)
+			gap = 0;
+		if (gap > maxgappx)
+			gap = maxgappx;
+		selmon->gappx = (int)gap;
+	}
+	arrange(selmon);
+}
