+static int
+getgappx(Monitor *m)
+{
+	int max = MIN(m->ww, m->wh);
+
+	if (max <= 1)
+		return 0;
+	return MAX(0, MIN(m->gappx, MIN(maxgappx, (max - 1) / 2)));
+}
